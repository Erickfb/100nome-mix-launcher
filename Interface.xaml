<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="100 Nome · Central do mix" Width="960" Height="660"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanMinimize"
        Background="#121218" Foreground="#F6F5FA" FontFamily="Inter, Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Grid Background="Transparent" Margin="2,2">
          <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
            <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb MinHeight="24">
              <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#655970" CornerRadius="3"/></ControlTemplate></Thumb.Template>
            </Thumb></Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
          </Track>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="aba" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#C4BACF"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="14,5"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="Capsula" Padding="{TemplateBinding Padding}" CornerRadius="5" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
          <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Capsula" Property="Background" Value="#282330"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Capsula" Property="Background" Value="#392B49"/><Setter Property="Foreground" Value="#E6CDFF"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Capsula" Property="BorderBrush" Value="#DAB8FF"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="button" TargetType="Button">
      <Setter Property="Foreground" Value="#ECEAF3"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="base" Background="{TemplateBinding Background}" CornerRadius="5" />
              <Border x:Name="hover" Background="#FFFFFF" Opacity="0" CornerRadius="5" />
              <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Center" RecognizesAccessKey="True"/>
              <Border x:Name="focus" BorderBrush="#E0D0FF" BorderThickness="1" CornerRadius="5" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="hover" Property="Opacity" Value="0.10"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="hover" Property="Opacity" Value="0.22"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="focus" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="legenda" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#BFBDCC"/>
    </Style>
    <Style x:Key="metrica" TargetType="TextBlock">
      <Setter Property="FontSize" Value="25"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="secao" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="19"/>
    </Style>
    <Style x:Key="opcaoEntrada" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
      <Setter Property="Foreground" Value="#F1EDF6"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="Cartao" Background="#201E28" BorderBrush="#46404F" BorderThickness="1" CornerRadius="6" Padding="12,7">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center">
              <Ellipse x:Name="Anel" Stroke="#A79CB6" StrokeThickness="1.5"/>
              <Ellipse x:Name="Ponto" Fill="#D8AEFF" Margin="4" Visibility="Collapsed"/>
            </Grid>
            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Cartao" Property="Background" Value="#302A39"/></Trigger>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="Cartao" Property="Background" Value="#352841"/>
            <Setter TargetName="Cartao" Property="BorderBrush" Value="#AB75DF"/>
            <Setter TargetName="Anel" Property="Stroke" Value="#D8AEFF"/>
            <Setter TargetName="Ponto" Property="Visibility" Value="Visible"/>
          </Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Cartao" Property="BorderBrush" Value="#F2DEFF"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.65"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="pingEntrada" TargetType="TextBlock">
      <Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="destaqueEntrada" TargetType="TextBlock">
      <Setter Property="Visibility" Value="Collapsed"/><Setter Property="Foreground" Value="#9CE6B7"/>
      <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="5,0,0,0"/>
    </Style>
    <Style x:Key="linkNoticia" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Linha" BorderThickness="1" BorderBrush="Transparent" CornerRadius="5" Background="{TemplateBinding Background}" Padding="8,7">
          <ContentPresenter HorizontalAlignment="Stretch"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Linha" Property="Background" Value="#2C2634"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Linha" Property="BorderBrush" Value="#DAB8FF"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border Background="#121218" BorderBrush="#35333F" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid x:Name="BarraTitulo" Background="#17161D">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel x:Name="TituloMarcaAgrupado" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,12,0" IsHitTestVisible="False">
          <Path Fill="#B481FF" Data="M0,11 L6,0 H11 L5,11 Z M8,11 L14,0 H19 L13,11 Z"/>
          <TextBlock Text="100 NOME" Margin="9,0,0,0" FontSize="14" FontWeight="Bold"/>
          <StackPanel x:Name="SubtituloMarca" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="1" Height="14" Background="#45414E" Margin="13,0"/>
            <TextBlock Text="Central do mix" FontSize="12" Foreground="#B2AFBE"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
          <RadioButton x:Name="AbaServidor" GroupName="Pagina" Style="{StaticResource aba}" IsChecked="True" Content="Servidor"/>
          <RadioButton x:Name="AbaNoticias" GroupName="Pagina" Style="{StaticResource aba}" Content="Notícias"/>
          <RadioButton x:Name="AbaEstatisticas" GroupName="Pagina" Style="{StaticResource aba}" Content="Estatísticas"/>
          <RadioButton x:Name="AbaComandos" GroupName="Pagina" Style="{StaticResource aba}" Content="Comandos"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="Minimizar" TabIndex="3" Style="{StaticResource button}" Width="44" ToolTip="Minimizar" AutomationProperties.Name="Minimizar">
            <Path Stroke="#CCC9D4" StrokeThickness="1.3" Data="M0,6 H12"/>
          </Button>
          <Button x:Name="Fechar" TabIndex="4" Style="{StaticResource button}" Width="44" ToolTip="Fechar" AutomationProperties.Name="Fechar">
            <Path Stroke="#CCC9D4" StrokeThickness="1.3" Data="M0,0 L11,11 M11,0 L0,11"/>
          </Button>
        </StackPanel>
      </Grid>

      <Grid x:Name="Hero" Grid.Row="1" ClipToBounds="True" Background="#1A1225">
        <Image x:Name="Cenario" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Counter-Strike 2"/>
        <Rectangle>
          <Rectangle.Fill><LinearGradientBrush StartPoint="0,0.6" EndPoint="1,0.34">
            <GradientStop Color="#FF140D20" Offset="0.03"/><GradientStop Color="#F51D102E" Offset="0.23"/>
            <GradientStop Color="#C72B1742" Offset="0.42"/><GradientStop Color="#4D3E204A" Offset="0.68"/><GradientStop Color="#1A2A1929" Offset="1"/>
          </LinearGradientBrush></Rectangle.Fill>
        </Rectangle>
        <Rectangle>
          <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#230B0711" Offset="0"/><GradientStop Color="#00110D1A" Offset="0.60"/><GradientStop Color="#AC100F18" Offset="1"/>
          </LinearGradientBrush></Rectangle.Fill>
        </Rectangle>
        <Canvas ClipToBounds="True" IsHitTestVisible="False">
          <Path Fill="#263A155C" Data="M0,0 H387 L222,310 H0 Z"/>
          <Path Stroke="#418D60BD" StrokeThickness="1" Data="M378,-30 L188,325"/>
          <Path Stroke="#23744F93" StrokeThickness="1" Data="M393,-30 L203,325"/>
        </Canvas>
        <Grid HorizontalAlignment="Left" Margin="46,14,0,15" Width="200" MaxHeight="210">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid Margin="3,4,3,5">
            <Image x:Name="Marca" Stretch="Uniform" Margin="14,4" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="100 Nome"/>
            <TextBlock Text="100 NOME" Foreground="#F2E7FF" FontFamily="Barlow Semi Condensed, Bahnschrift, Segoe UI" FontSize="31" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock.Style><Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers><DataTrigger Binding="{Binding Source, ElementName=Marca}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
              </Style></TextBlock.Style>
            </TextBlock>
            <Path Data="M0,13 V0 H13" Stroke="#9860D7" StrokeThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Path Data="M0,13 H13 V0" Stroke="#9860D7" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
          </Grid>
          <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
            <Rectangle Fill="#A468E7" Width="16" Height="2" VerticalAlignment="Center"/>
            <TextBlock Text="COUNTER-STRIKE 2" FontFamily="Barlow Semi Condensed, Bahnschrift, Segoe UI" FontWeight="SemiBold" Foreground="#E4D9EE" FontSize="12" Margin="9,0"/>
            <Rectangle Fill="#A468E7" Width="16" Height="2" VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>
        <Border Height="2" VerticalAlignment="Bottom"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#A557F6"/><GradientStop Color="#573176" Offset="0.47"/><GradientStop Color="#2C2730" Offset="1"/></LinearGradientBrush></Border.Background></Border>
      </Grid>

      <StackPanel x:Name="ResumoServidor" Grid.Row="2" Margin="27,14,27,14">
        <Grid Margin="0,0,0,13">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Servidor do mix" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Border x:Name="FundoEstado" Background="#292631" CornerRadius="12" Margin="12,0,0,0" Padding="8,3" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="PontoEstado" Width="6" Height="6" Fill="#B4ACBD" Margin="0,0,6,0"/>
                <TextBlock x:Name="TextoEstado" FontSize="11" FontWeight="SemiBold" Foreground="#C5C0CE" Text="Consultando"/>
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel x:Name="AcoesResumo" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="AbrirDiscord" Style="{StaticResource button}" Content="Discord do mix" Margin="0,0,6,0"
                    Padding="10,5" Background="#34283F" Foreground="#E6CDFF" FontSize="12" FontWeight="SemiBold"
                    ToolTip="Abrir o canal do CS2 Mix no Discord" AutomationProperties.Name="Abrir Discord do mix"/>
            <Button x:Name="Atualizar" TabIndex="1" Style="{StaticResource button}" ToolTip="Consultar o servidor agora" AutomationProperties.Name="Atualizar servidor">
              <StackPanel Orientation="Horizontal">
                <Path Stroke="#C8C3D0" StrokeThickness="1.5" StrokeLineJoin="Round" VerticalAlignment="Center" Data="M12,5 A5,5 0 1 0 12,9 M12,1 V5 H8"/>
                <TextBlock Text="Atualizar" FontSize="12" Foreground="#C8C3D0" Margin="7,0,0,0"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
        <Border CornerRadius="7" Background="#1E1D26" BorderBrush="#35323F" BorderThickness="1" Padding="0,13">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <StackPanel Margin="19,0">
              <TextBlock Text="Mapa atual" Style="{StaticResource legenda}"/>
              <TextBlock x:Name="Mapa" Text="—" Style="{StaticResource metrica}"/>
            </StackPanel>
            <Border Grid.Column="1" BorderBrush="#373440" BorderThickness="1,0,0,0" Padding="19,0">
              <StackPanel><TextBlock Text="Modo atual" Style="{StaticResource legenda}"/>
                <TextBlock x:Name="Modo" Text="—" Style="{StaticResource metrica}"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" BorderBrush="#373440" BorderThickness="1,0,0,0" Padding="19,0">
              <StackPanel><TextBlock Text="Conectados" Style="{StaticResource legenda}"/>
                <StackPanel Orientation="Horizontal"><TextBlock x:Name="Jogadores" Text="—" Style="{StaticResource metrica}"/>
                  <TextBlock x:Name="Vagas" FontSize="17" Foreground="#A5A0B0" Margin="6,0,0,3" VerticalAlignment="Bottom"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </Grid>
        </Border>
        <DockPanel Margin="0,7,0,5">
          <Button x:Name="UsarMenorPing" DockPanel.Dock="Right" Content="Usar menor ping" Style="{StaticResource button}" FontSize="12" Padding="8,3" Background="#34283F" ToolTip="Retomar a seleção automática entre as entradas disponíveis"/>
          <Button x:Name="VincularEntrada" DockPanel.Dock="Right" Content="Liberar Entrada 2" Style="{StaticResource button}" FontSize="12" Margin="0,0,6,0" Padding="8,3" Background="#34283F" Visibility="Collapsed"/>
          <TextBlock Text="Entradas do mix" Foreground="#D8D2E0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <RadioButton x:Name="OpcaoEntrada1" GroupName="Entradas" TabIndex="0" Style="{StaticResource opcaoEntrada}" AutomationProperties.Name="Entrada 1">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="Entrada 1" Style="{StaticResource legenda}"/><TextBlock x:Name="PingEntrada1" Text="Medindo…" Style="{StaticResource pingEntrada}"/></StackPanel>
              <TextBlock Grid.Column="1" x:Name="DestaqueEntrada1" Text="Menor ping" Style="{StaticResource destaqueEntrada}"/>
            </Grid>
          </RadioButton>
          <RadioButton x:Name="OpcaoEntrada2" Grid.Column="2" GroupName="Entradas" TabIndex="0" Style="{StaticResource opcaoEntrada}" AutomationProperties.Name="Entrada 2">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="Entrada 2" Style="{StaticResource legenda}"/><TextBlock x:Name="PingEntrada2" Text="Medindo…" Style="{StaticResource pingEntrada}"/></StackPanel>
              <TextBlock Grid.Column="1" x:Name="DestaqueEntrada2" Text="Menor ping" Style="{StaticResource destaqueEntrada}"/>
            </Grid>
          </RadioButton>
          <RadioButton x:Name="OpcaoEntrada3" Grid.Column="4" GroupName="Entradas" TabIndex="0" Style="{StaticResource opcaoEntrada}" AutomationProperties.Name="Entrada 3">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="Entrada 3" Style="{StaticResource legenda}"/><TextBlock x:Name="PingEntrada3" Text="Medindo…" Style="{StaticResource pingEntrada}"/></StackPanel>
              <TextBlock Grid.Column="1" x:Name="DestaqueEntrada3" Text="Menor ping" Style="{StaticResource destaqueEntrada}"/>
            </Grid>
          </RadioButton>
        </Grid>
      </StackPanel>

      <Grid x:Name="Noticias" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" Margin="27,16,23,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Notícias" FontWeight="SemiBold" FontSize="27" Margin="0,0,0,13"/>
        <ScrollViewer x:Name="RolagemNoticias" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid x:Name="ColunasNoticias" Margin="0,0,4,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
              <Grid ClipToBounds="True" Background="#23172E" MinHeight="145">
                <Image x:Name="ArteNoticia" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Height="145" VerticalAlignment="Stretch"/>
                <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0.9" EndPoint="1,0.15">
                  <GradientStop Color="#FF21122E"/><GradientStop Color="#E3312144" Offset=".47"/><GradientStop Color="#372C203C" Offset="1"/>
                </LinearGradientBrush></Rectangle.Fill></Rectangle>
                <StackPanel Margin="16,13" VerticalAlignment="Bottom">
                  <TextBlock x:Name="VersaoNoticia" Foreground="#E5B6FF" FontWeight="Bold" FontSize="11" Margin="0,0,0,5"/>
                  <TextBlock Text="Demos dos mixes" Foreground="White" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock Text="O servidor guarda a demo das partidas organizadas com !mix." Foreground="#F0E5F4" Margin="0,3,0,0" FontSize="13" TextWrapping="Wrap"/>
                </StackPanel>
              </Grid>
              <WrapPanel Margin="0,12,0,1">
                <TextBlock Text="Mudanças no mix" Style="{StaticResource secao}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button x:Name="AbrirNotasVersao" Content="Notas desta versão" Foreground="#DAB8FF" FontSize="13"
                        Style="{StaticResource linkNoticia}" Visibility="Collapsed" VerticalAlignment="Center"/>
              </WrapPanel>
              <ItemsControl x:Name="MuralMix">
                <ItemsControl.ItemTemplate><DataTemplate>
                  <Border BorderBrush="#34313C" BorderThickness="0,0,0,1" Padding="0,10,4,11">
                    <StackPanel>
                      <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" FontSize="15" Foreground="#EADDF4" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Texto}" Margin="0,3,0,0" Foreground="#C9C3D2" FontSize="13" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <Border x:Name="PainelSteam" Grid.Column="1" VerticalAlignment="Top" Margin="17,0,0,0" Padding="12,12" CornerRadius="7" Background="#1D1B24" BorderBrush="#37333F" BorderThickness="1">
              <StackPanel>
                <Grid Margin="3,0,0,4">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Counter-Strike 2" Style="{StaticResource secao}"/>
                    <TextBlock Text="Notícias oficiais na Steam" Style="{StaticResource legenda}" Margin="0,1"/>
                  </StackPanel>
                  <Button x:Name="AtualizarNoticias" Grid.Column="1" Style="{StaticResource button}" Padding="3" Width="30" Height="30" VerticalAlignment="Center" ToolTip="Atualizar notícias da Steam" AutomationProperties.Name="Atualizar notícias da Steam">
                    <Path Stroke="#CEC1DB" StrokeThickness="1.5" StrokeLineJoin="Round" VerticalAlignment="Center" Data="M12,5 A5,5 0 1 0 12,9 M12,1 V5 H8"/>
                  </Button>
                </Grid>
                <TextBlock x:Name="EstadoNoticias" Margin="3,8,3,4" Foreground="#BEB5C8" FontSize="12" TextWrapping="Wrap" Text="Consultando a Steam…"/>
                <ItemsControl x:Name="ListaSteam">
                  <ItemsControl.ItemTemplate><DataTemplate>
                    <Button Style="{StaticResource linkNoticia}" Tag="{Binding Link}" ToolTip="Abrir notícia no navegador" AutomationProperties.Name="{Binding Titulo}">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="15"/></Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="{Binding Data}" Foreground="#BAA8C9" FontSize="11"/>
                          <TextBlock Text="{Binding Titulo}" Foreground="#F1EAF6" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Path Grid.Column="1" Data="M1,9 L9,1 M2,1 H9 V8" Stroke="#BE91E6" StrokeThickness="1.2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                      </Grid>
                    </Button>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </Grid>
        </ScrollViewer>
      </Grid>

      <Grid x:Name="Estatisticas" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" Margin="27,16,23,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,4,13">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="Estatísticas do mix" FontWeight="SemiBold" FontSize="27"/>
          <Button x:Name="AtualizarHistorico" Grid.Column="1" Content="Atualizar" Style="{StaticResource button}" ToolTip="Consultar o histórico no servidor" AutomationProperties.Name="Atualizar estatísticas do mix"/>
        </Grid>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,0,4,0">
            <Border BorderBrush="#56425F" BorderThickness="1" CornerRadius="8" Padding="18,14">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.8">
                  <GradientStop Color="#352841" Offset="0"/><GradientStop Color="#24202F" Offset="0.53"/><GradientStop Color="#201D28" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Image x:Name="DistintivoPessoal" Width="144" Height="59" Visibility="Collapsed" Stretch="Uniform" Margin="0,0,16,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="Sua patente do mix" Foreground="#D5C2E8" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                  <TextBlock x:Name="TituloPatente" Text="Consultando patente…" Foreground="#F9F5FD" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0"/>
                  <TextBlock x:Name="DetalhePatente" Foreground="#D8CFDF" TextWrapping="Wrap" FontSize="13" Margin="0,4,0,0" Visibility="Collapsed"/>
                </StackPanel>
              </Grid>
            </Border>
            <Button x:Name="AlternarCatalogo" Content="Ver as 18 patentes" HorizontalAlignment="Left" Style="{StaticResource button}" Padding="5,6" Foreground="#D9B5FA" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,11"/>
            <ItemsControl x:Name="CatalogoPatentes" Margin="0,0,0,14" Visibility="Collapsed" AutomationProperties.Name="Patentes do 100Nome e pontuação mínima">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate>
                <Border Margin="3" Background="#211E29" BorderBrush="#393340" BorderThickness="1" CornerRadius="5" Padding="8,10">
                  <StackPanel>
                    <Image Source="{Binding Arte}" Stretch="Uniform" Width="128" Height="52" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="{Binding Nome}">
                      <Image.Style><Style TargetType="Image"><Style.Triggers><DataTrigger Binding="{Binding Arte}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Image.Style>
                    </Image>
                    <TextBlock Text="{Binding Nome}" Foreground="#EFEAF3" FontWeight="SemiBold" FontSize="13" Margin="0,6,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Legenda}" Foreground="#BDB2C7" FontSize="12" TextAlignment="Center"/>
                  </StackPanel>
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Mixes competitivos de 1x1 a 5x5 que chegaram ao placar final." Foreground="#C9C3D2" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,14"/>
            <Border CornerRadius="7" Background="#211D29" BorderThickness="1" BorderBrush="#3B3445" Padding="3,14">
              <UniformGrid x:Name="CartoesEstatisticas" Columns="4">
                <StackPanel Margin="12,0"><TextBlock Text="Partidas concluídas" Style="{StaticResource legenda}"/><TextBlock x:Name="HistoricoPartidas" Text="—" Style="{StaticResource metrica}"/></StackPanel>
                <StackPanel Margin="12,0"><TextBlock Text="Jogadores únicos" Style="{StaticResource legenda}"/><TextBlock x:Name="HistoricoJogadores" Text="—" Style="{StaticResource metrica}"/></StackPanel>
                <StackPanel Margin="12,0"><TextBlock Text="Rodadas jogadas" Style="{StaticResource legenda}"/><TextBlock x:Name="HistoricoRodadas" Text="—" Style="{StaticResource metrica}"/></StackPanel>
                <StackPanel Margin="12,0"><TextBlock Text="Empates" Style="{StaticResource legenda}"/><TextBlock x:Name="HistoricoEmpates" Text="—" Style="{StaticResource metrica}"/></StackPanel>
              </UniformGrid>
            </Border>
            <TextBlock Text="Último mix" Style="{StaticResource secao}" Margin="1,22,0,9"/>
            <Border Background="#1D1B24" BorderBrush="#36323E" BorderThickness="1" CornerRadius="7" Padding="13">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Image x:Name="ArteUltimaPartida" Width="116" Height="68" Stretch="UniformToFill" Margin="0,0,14,0" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock x:Name="MapaUltimaPartida" FontWeight="SemiBold" FontSize="18" TextWrapping="Wrap"/>
                  <TextBlock x:Name="DetalheUltimaPartida" Foreground="#C6BED1" FontSize="13" Margin="0,3,0,0" TextWrapping="Wrap" Text="Consultando o servidor…"/>
                </StackPanel>
                <TextBlock x:Name="PlacarUltimaPartida" Grid.Column="2" Margin="8,0,0,0" FontSize="28" FontWeight="SemiBold" Foreground="#E4C6FF" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <TextBlock x:Name="EstadoHistorico" Foreground="#ACA2B7" FontSize="12" Margin="1,9,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="Seu desempenho" Style="{StaticResource secao}" Margin="1,21,0,6"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="No chat do CS2, consulte seus pontos, eliminações, assistências, dano e objetivos no último mix." Foreground="#C9C3D2" FontSize="13" TextWrapping="Wrap" Margin="1,0,12,0" VerticalAlignment="Center"/>
              <Button x:Name="CopiarDesempenho" Grid.Column="1" Style="{StaticResource button}" Padding="11,7" Background="#352841" Foreground="#E4C6FF" Content="Copiar !desempenho" FontSize="12"/>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Grid x:Name="Guia" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" Margin="27,20,27,14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,12,0">
            <TextBlock Text="Comandos do mix" FontSize="25" FontWeight="SemiBold"/>
            <TextBlock Text="Abra o chat geral com Y e digite o comando." Foreground="#C4BECE" Margin="0,4,0,0"/>
          </StackPanel>
          <Border Grid.Column="1" Background="#211D28" BorderBrush="#494051" BorderThickness="1" CornerRadius="6" Padding="11,7" VerticalAlignment="Center">
            <Grid>
              <TextBox x:Name="Busca" Background="Transparent" BorderThickness="0" Foreground="#F6F1FB" CaretBrush="#F3DFFF" MaxLength="80" AutomationProperties.Name="Buscar comando"/>
              <TextBlock x:Name="DicaBusca" Text="Buscar comando…" Foreground="#B9B1C4" Margin="2,0" IsHitTestVisible="False"/>
            </Grid>
          </Border>
        </Grid>
        <WrapPanel x:Name="Filtros" Grid.Row="1" Margin="0,15,0,12"/>
        <Grid Grid.Row="2">
          <ScrollViewer x:Name="RolagemGuia" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ListaComandos">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="#302D37" BorderThickness="0,0,0,1" Padding="6,9">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="1.02*"/><ColumnDefinition Width="2.15*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Comando}" Foreground="#E0B9FF" FontFamily="Consolas" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>
                      <TextBlock Grid.Column="1" Text="{Binding Descricao}" Foreground="#D5D0DC" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,9,0"/>
                      <Button Grid.Column="2" Style="{StaticResource button}" Padding="3,4" Content="Copiar" FontSize="11" Tag="{Binding Exemplo}" ToolTip="{Binding DicaAcao}" AutomationProperties.Name="{Binding DicaAcao}"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock x:Name="SemResultados" Visibility="Collapsed" Text="Nenhum comando encontrado." Foreground="#C4BECE" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
      </Grid>

      <Border Grid.Row="3" BorderBrush="#302C39" BorderThickness="0,1,0,0" Background="#17161D" Padding="27,10">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid VerticalAlignment="Center" Margin="0,0,12,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Grid.ColumnSpan="2" x:Name="Mensagem" Foreground="#BFB8CB" FontSize="12" TextWrapping="Wrap"/>
            <DockPanel Grid.Row="1" HorizontalAlignment="Left" Margin="0,1,0,0">
              <Button x:Name="Copiar" DockPanel.Dock="Right" TabIndex="2" Margin="5,0,0,0" Style="{StaticResource button}" Padding="6,4" Visibility="Collapsed" ToolTip="Copiar endereço do servidor" AutomationProperties.Name="Copiar endereço do servidor">
                <Path Stroke="#A8A2B4" StrokeThickness="1.2" StrokeLineJoin="Round" Data="M4,4 H12 V12 H4 Z M1,9 V1 H9"/>
              </Button>
              <TextBlock x:Name="Endereco" FontFamily="Consolas" FontSize="14" VerticalAlignment="Center" Foreground="#ECE8F1" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <TextBlock x:Name="EstadoVersao" Grid.Row="1" Grid.Column="1" Foreground="#AAA2B5" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5,1,0,0" TextTrimming="CharacterEllipsis"/>
          </Grid>
          <Button Grid.Column="1" x:Name="Entrar" TabIndex="1" IsEnabled="False" HorizontalAlignment="Right" Background="#7943CD" Style="{StaticResource button}" Padding="6,4" Width="190" Height="47" AutomationProperties.Name="Entrar no mix">
            <StackPanel Orientation="Horizontal">
              <Path Fill="White" Data="M1,0 L12,7 L1,14 Z" VerticalAlignment="Center"/>
              <TextBlock x:Name="TextoEntrar" Text="Entrar no mix" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="11,0,0,0"/>
            </StackPanel>
          </Button>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
